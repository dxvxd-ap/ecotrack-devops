# Copiar a .env.local una sola vez y completar por un canal privado.
# Servidor Next.js: nunca copiar secretos a variables NEXT_PUBLIC_* ni VITE_*.
MONGODB_URI=
CLERK_SECRET_KEY=
GEOAPIFY_API_KEY=

# Pública: misma instancia Clerk que utiliza la PWA.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Opcionales: reconocimiento de fundador en la autorización existente.
# No otorgan por sí solos autorización sobre cuentas divergentes o bloqueadas.
SUPERADMIN_USER_ID=
ADMIN_CORREO=

diff --git a/src/lib/autorizacion.ts b/src/lib/autorizacion.ts
new file mode 100644
index 0000000..ab63ea0
--- /dev/null
+++ b/src/lib/autorizacion.ts
@@ -0,0 +1,141 @@
+import { auth } from "@clerk/nextjs/server";
+import { createClerkClient } from "@clerk/backend";
+import { NextResponse } from "next/server";
+
+export const ROLES_INFERIORES = ["secretario", "moderador", "ciudadano", "conductor", "camion"] as const;
+export const ROLES_CONOCIDOS: readonly string[] = ["superadmin", "admin", ...ROLES_INFERIORES];
+export type PermisoAdministrativo = "usuarios:ver" | "usuarios:gestionar" | "usuarios:eliminar" |
+  "roles:ver" | "roles:crear" | "preasignaciones:gestionar";
+const PERMISOS: Record<string, readonly PermisoAdministrativo[]> = {
+  superadmin: ["usuarios:ver", "usuarios:gestionar", "usuarios:eliminar", "roles:ver", "roles:crear", "preasignaciones:gestionar"],
+  admin: ["usuarios:ver", "usuarios:gestionar", "roles:ver", "preasignaciones:gestionar"],
+};
+
+export type UsuarioSeguridad = {
+  id: string;
+  publicMetadata: Record<string, unknown>;
+  primaryEmailAddressId: string | null;
+  emailAddresses: { id: string; emailAddress: string; verification?: { status: string } | null }[];
+  banned?: boolean;
+  locked?: boolean;
+};
+export type ActorAdministrativo = { usuario: UsuarioSeguridad; rol: string };
+
+export class ErrorAdministrativo extends Error {
+  constructor(public status: number, mensaje: string) { super(mensaje); }
+}
+
+export function cliente_clerk_administrativo() {
+  return createClerkClient({ secretKey: process.env.CLERK_SECRET_KEY });
+}
+
+// Identificadores ya existentes en middleware y sincronizar; no se crean cuentas.
+const ID_FUNDADOR = "user_3JzRT8FQJPrqKEfk2QdjZpFaRVN";
+const CORREO_FUNDADOR = "22610282@utgz.edu.mx";
+export function es_identidad_fundador(id?: string, correo?: string): boolean {
+  return Boolean((id && [ID_FUNDADOR, process.env.SUPERADMIN_USER_ID].includes(id)) ||
+    (correo && [CORREO_FUNDADOR, process.env.ADMIN_CORREO?.trim().toLowerCase()].includes(correo.toLowerCase())));
+}
+
+export function rol_efectivo(usuario: UsuarioSeguridad): string {
+  if (es_identidad_fundador(usuario.id) || usuario.emailAddresses.some(e =>
+    e.verification?.status === "verified" && es_identidad_fundador(undefined, e.emailAddress))) return "superadmin";
+  // Nunca inferir permisos de acceso_dashboard ni de metadatos enviados por cliente.
+  return typeof usuario.publicMetadata.rol === "string" ? usuario.publicMetadata.rol.trim().toLowerCase() : "ciudadano";
+}
+
+export async function autorizar_administracion(permiso: PermisoAdministrativo, id_sesion?: string | null): Promise<ActorAdministrativo> {
+  try {
+    const id = id_sesion === undefined ? (await auth()).userId : id_sesion;
+    if (!id) throw new ErrorAdministrativo(401, "No hay sesión activa de usuario");
+    const usuario = await cliente_clerk_administrativo().users.getUser(id);
+    const rol = rol_efectivo(usuario);
+    if (usuario.banned || usuario.locked || !Object.hasOwn(PERMISOS, rol) || !PERMISOS[rol].includes(permiso)) {
+      throw new ErrorAdministrativo(403, "No tienes permisos para esta operación");
+    }
+    return { usuario, rol };
+  } catch (error) {
+    if (error instanceof ErrorAdministrativo) throw error;
+    throw new ErrorAdministrativo(503, "No se pudo verificar la autorización con Clerk");
+  }
+}
+
+export function permiso_api_administrativa(ruta: string, metodo: string): PermisoAdministrativo | null {
+  const normalizada = ruta.replace(/\/+$/, "");
+  if (normalizada === "/api/usuarios/preasignar") return "preasignaciones:gestionar";
+  if (normalizada === "/api/usuarios") return metodo === "GET" ? "usuarios:ver" : metodo === "DELETE" ? "usuarios:eliminar" : "usuarios:gestionar";
+  if (normalizada === "/api/roles") return metodo === "GET" ? "roles:ver" : "roles:crear";
+  return null;
+}
+
+export function texto_opcional(valor: unknown, campo: string): string | undefined {
+  if (valor === undefined || valor === null) return undefined;
+  if (typeof valor !== "string" || !valor.trim()) throw new ErrorAdministrativo(400, `Campo inválido: ${campo}`);
+  return valor.trim();
+}
+
+export function correo_validado(valor: unknown): string | undefined {
+  const correo = texto_opcional(valor, "correo_electronico")?.toLowerCase();
+  if (correo && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(correo)) throw new ErrorAdministrativo(400, "Correo electrónico inválido");
+  return correo;
+}
+
+export function validar_rol_asignable(actor: ActorAdministrativo, valor: unknown): string {
+  const rol = texto_opcional(valor, "rol")?.toLowerCase();
+  if (!rol || !ROLES_CONOCIDOS.includes(rol) ||
+    (actor.rol === "admin" && !(ROLES_INFERIORES as readonly string[]).includes(rol))) {
+    throw new ErrorAdministrativo(403, "No puedes asignar ese rol");
+  }
+  return rol;
+}
+
+export async function resolver_usuario_clerk(id?: string, correo?: string): Promise<UsuarioSeguridad | null> {
+  try {
+    const cliente = cliente_clerk_administrativo();
+    if (id) {
+      if (!/^user_[a-zA-Z0-9_]+$/.test(id)) throw new ErrorAdministrativo(400, "Se requiere un ID de usuario de Clerk válido");
+      const usuario = await cliente.users.getUser(id);
+      if (correo && !usuario.emailAddresses.some(e => e.emailAddress.toLowerCase() === correo)) {
+        throw new ErrorAdministrativo(400, "El ID y el correo no corresponden a la misma cuenta");
+      }
+      return usuario;
+    }
+    if (!correo) throw new ErrorAdministrativo(400, "Se requiere identificación del usuario");
+    const resultado = await cliente.users.getUserList({ emailAddress: [correo], limit: 2 });
+    if (resultado.totalCount > 1) throw new ErrorAdministrativo(409, "Identidad ambigua");
+    const usuario = resultado.data[0];
+    if (usuario && !usuario.emailAddresses.some(e => e.emailAddress.toLowerCase() === correo)) {
+      throw new ErrorAdministrativo(409, "Clerk devolvió una identidad inconsistente");
+    }
+    return usuario || null;
+  } catch (error) {
+    if (error instanceof ErrorAdministrativo) throw error;
+    if ((error as { status?: number }).status === 404) throw new ErrorAdministrativo(404, "Usuario no encontrado");
+    throw new ErrorAdministrativo(503, "No se pudo verificar la identidad con Clerk");
+  }
+}
+
+export function validar_gestion_objetivo(actor: ActorAdministrativo, objetivo: {
+  id?: string; correo?: string; roles: string[]; fundador?: boolean;
+}, cambio: { eliminar?: boolean; cancelar_preasignacion?: boolean; rol?: string; activo?: boolean }) {
+  if (objetivo.roles.some(rol => !ROLES_CONOCIDOS.includes(rol))) throw new ErrorAdministrativo(403, "El rol objetivo no tiene una jerarquía definida");
+  if (actor.rol === "admin" && (cambio.eliminar || objetivo.fundador || es_identidad_fundador(objetivo.id, objetivo.correo) ||
+    objetivo.roles.some(rol => !(ROLES_INFERIORES as readonly string[]).includes(rol)))) {
+    throw new ErrorAdministrativo(403, "No puedes administrar esta cuenta");
+  }
+  const protegido = objetivo.fundador || es_identidad_fundador(objetivo.id, objetivo.correo) || objetivo.roles.includes("superadmin");
+  // No hay CAS entre Clerk y MongoDB: bloquear todos los superadmins evita
+  // depender de un conteo vulnerable a borrados/degradaciones concurrentes.
+  if (protegido && (cambio.eliminar || cambio.cancelar_preasignacion || cambio.activo === false || (cambio.rol !== undefined && cambio.rol !== "superadmin"))) {
+    throw new ErrorAdministrativo(403, "No se permite eliminar, degradar o desactivar al fundador ni a cuentas superadmin");
+  }
+  if (objetivo.id === actor.usuario.id && cambio.rol && cambio.rol !== actor.rol) {
+    throw new ErrorAdministrativo(403, "No puedes cambiar tus propios privilegios");
+  }
+}
+
+export function respuesta_error_administrativo(error: unknown) {
+  const status = error instanceof ErrorAdministrativo ? error.status : error instanceof SyntaxError ? 400 : 503;
+  const mensaje = error instanceof ErrorAdministrativo ? error.message : status === 400 ? "JSON inválido" : "No se pudo completar la operación administrativa";
+  return NextResponse.json({ exito: false, mensaje }, { status });
+}
diff --git a/src/lib/usuarios_administrativos.ts b/src/lib/usuarios_administrativos.ts
new file mode 100644
index 0000000..e09eaa4
--- /dev/null
+++ b/src/lib/usuarios_administrativos.ts
@@ -0,0 +1,115 @@
+import { conectar_base_datos } from "@/lib/base_datos";
+import { ModeloUsuario } from "@/modelos/Usuario";
+import { ModeloPreasignacionUsuario } from "@/modelos/PreasignacionUsuario";
+import { ModeloBloqueoAdministrativo } from "@/modelos/BloqueoAdministrativo";
+import { leer_almacen_local, guardar_almacen_local } from "@/lib/almacen_local";
+import { ActorAdministrativo, UsuarioSeguridad, ErrorAdministrativo, resolver_usuario_clerk,
+  rol_efectivo, es_identidad_fundador, validar_gestion_objetivo, cliente_clerk_administrativo,
+  autorizar_administracion, validar_rol_asignable } from "./autorizacion";
+
+type CambioSeguridad = { eliminar?: boolean; cancelar_preasignacion?: boolean; crear_preasignacion?: boolean; rol?: string; activo?: boolean };
+
+export async function con_objetivo_bloqueado<T>(actor: ActorAdministrativo, id: string | undefined,
+  correo: string | undefined, cambio: CambioSeguridad,
+  operar: (objetivo: Awaited<ReturnType<typeof preparar_objetivo>>) => Promise<T>): Promise<T> {
+  // Resolver alias antes de bloquear; por ID y correo se utiliza la misma clave.
+  const identidad = await resolver_usuario_clerk(id, correo);
+  const clave = identidad?.id || `correo:${correo}`;
+  await conectar_base_datos();
+  let operacion_iniciada = false;
+  let operacion_completada = false;
+  try {
+    await ModeloBloqueoAdministrativo.create({ _id: clave });
+  } catch (error) {
+    if ((error as { code?: number }).code === 11000) throw new ErrorAdministrativo(409, "La cuenta tiene una operación administrativa en curso o pendiente de recuperación");
+    throw new ErrorAdministrativo(503, "No se pudo garantizar exclusión para esta cuenta");
+  }
+  try {
+    // Releer autorización y objetivo DENTRO del bloqueo, nunca usar el snapshot
+    // anterior. Todas las mutaciones administrativas de cuentas pasan por aquí.
+    const actor_actual = await autorizar_administracion(cambio.eliminar ? "usuarios:eliminar" : "usuarios:gestionar", actor.usuario.id);
+    if (cambio.rol) {
+      // El actor podría haber sido degradado entre la autorización inicial y el bloqueo.
+      validar_rol_asignable(actor_actual, cambio.rol);
+    }
+    const objetivo = await preparar_objetivo(actor_actual, id, correo, cambio);
+    if ((objetivo.usuario?.id || `correo:${objetivo.correo}`) !== clave) {
+      throw new ErrorAdministrativo(409, "La identidad cambió durante la operación; vuelve a intentarlo");
+    }
+    if (!objetivo.existe && !cambio.crear_preasignacion && !cambio.cancelar_preasignacion) {
+      throw new ErrorAdministrativo(404, "Usuario o preasignación no encontrado");
+    }
+    operacion_iniciada = true;
+    const resultado = await operar(objetivo);
+    operacion_completada = true;
+    return resultado;
+  } finally {
+    // Si liberar falla, el bloqueo permanece y las siguientes escrituras fallan
+    // cerradas. No se retira automáticamente un bloqueo abandonado.
+    // Una excepción tras iniciar escrituras puede ser un resultado remoto
+    // incierto. Mantener el bloqueo evita reintentos que se solapen con él.
+    if (!operacion_iniciada || operacion_completada) {
+      await ModeloBloqueoAdministrativo.deleteOne({ _id: clave });
+    }
+  }
+}
+
+export async function preparar_objetivo(actor: ActorAdministrativo, id: string | undefined, correo_solicitado: string | undefined,
+  cambio: CambioSeguridad) {
+  const usuario = await resolver_usuario_clerk(id, correo_solicitado);
+  const correo = correo_solicitado || usuario?.emailAddresses.find(e => e.id === usuario.primaryEmailAddressId)?.emailAddress.toLowerCase()
+    || usuario?.emailAddresses[0]?.emailAddress.toLowerCase();
+  if (!correo) throw new ErrorAdministrativo(400, "No se pudo determinar el correo de la cuenta");
+  // Se revisan TODAS las fuentes antes de escribir: una caída de BD no permite
+  // omitir un rol privilegiado o una identidad conflictiva de una preasignación.
+  await conectar_base_datos();
+  const pre_db = await ModeloPreasignacionUsuario.findOne({ correo_electronico: correo });
+  const usuario_db = await ModeloUsuario.findOne({ correo_electronico: correo });
+  const usuario_db_id = usuario ? await ModeloUsuario.findOne({ id_clerk: usuario.id }) : null;
+  if ((usuario_db && usuario_db.id_clerk !== usuario?.id) ||
+      (usuario_db_id && usuario_db_id.correo_electronico.toLowerCase() !== correo)) {
+    throw new ErrorAdministrativo(409, "La identidad de MongoDB no coincide con Clerk");
+  }
+  const almacen = leer_almacen_local();
+  const pre_local = (almacen.preasignaciones || []).filter((p: { correo_electronico: string }) => p.correo_electronico.toLowerCase() === correo);
+  const roles = [usuario ? rol_efectivo(usuario) : undefined, usuario_db?.rol,
+    pre_db?.rol_asignado, ...pre_local.map((p: { rol_asignado: string }) => p.rol_asignado)]
+    .filter((r): r is string => r !== undefined).map(r => typeof r === "string" ? r.trim().toLowerCase() : "");
+  const fundador = usuario ? es_fundador_protegido(usuario) : es_identidad_fundador(undefined, correo);
+  validar_gestion_objetivo(actor, { id: usuario?.id, correo, roles, fundador }, cambio);
+  return { usuario, correo, almacen, existe: Boolean(usuario || pre_db || pre_local.length), pre_db };
+}
+
+function es_fundador_protegido(usuario: UsuarioSeguridad) {
+  return es_identidad_fundador(usuario.id) || usuario.emailAddresses.some(e => es_identidad_fundador(undefined, e.emailAddress));
+}
+
+export async function actualizar_objetivo(objetivo: Awaited<ReturnType<typeof preparar_objetivo>>, cambio: {
+  rol?: string; nombre_completo?: string; activo?: boolean;
+}) {
+  const { usuario, correo, almacen } = objetivo;
+  if (!objetivo.existe) throw new ErrorAdministrativo(404, "Usuario o preasignación no encontrado");
+  if (usuario) {
+    const partes = cambio.nombre_completo?.split(/\s+/);
+    await cliente_clerk_administrativo().users.updateUser(usuario.id, {
+      ...(partes ? { firstName: partes[0], lastName: partes.slice(1).join(" ") } : {}),
+      ...(cambio.rol ? { publicMetadata: { ...usuario.publicMetadata, rol: cambio.rol,
+        acceso_dashboard: ["superadmin", "admin", "secretario", "moderador"].includes(cambio.rol) } } : {}),
+    });
+  }
+  const actualizacion = {
+    ...(cambio.rol ? { rol_asignado: cambio.rol } : {}),
+    ...(cambio.nombre_completo ? { nombre_completo: cambio.nombre_completo } : {}),
+  };
+  await ModeloPreasignacionUsuario.findOneAndUpdate({ correo_electronico: correo }, { $set: actualizacion });
+  if (usuario) await ModeloUsuario.findOneAndUpdate({ id_clerk: usuario.id, correo_electronico: correo }, { $set: {
+    fecha_actualizacion: new Date(), ...(cambio.rol ? { rol: cambio.rol } : {}),
+    ...(cambio.nombre_completo ? { nombre_completo: cambio.nombre_completo } : {}),
+    ...(cambio.activo !== undefined ? { activo: cambio.activo } : {}),
+  } });
+  let modificado = false;
+  for (const p of almacen.preasignaciones || []) if (p.correo_electronico.toLowerCase() === correo) {
+    Object.assign(p, actualizacion); modificado = true;
+  }
+  if (modificado) guardar_almacen_local(almacen);
+}

{
  "name": "ecotrack-ciudadano",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "https:prepare": "node scripts/prepare-https.mjs",
    "https:check": "node scripts/check-https.mjs",
    "dev:https": "ECOTRACK_HTTPS=1 vite --host 0.0.0.0 --port 5443",
    "preview:eco": "vite preview --mode eco --host 0.0.0.0",
    "preview:https": "ECOTRACK_HTTPS=1 vite preview --mode eco --host 0.0.0.0 --port 4443",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts tests/*.test.mjs",
    "build": "npm run typecheck && vite build",
    "build:eco": "npm run typecheck && vite build --mode eco",
    "build:android": "npm run typecheck && vite build --mode android",
    "preview": "vite preview --host 0.0.0.0",
    "android:sync": "npm run build:android && cap sync android",
    "android:open": "cap open android",
    "test:vercel": "node scripts/vercel-smoke.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "stage:web": "node scripts/stage-web.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.0.0",
    "@capacitor/core": "8.6.2",
    "@capacitor/geolocation": "8.0.0",
    "@clerk/react": "6.18.8",
    "lucide-react": "0.475.0",
    "maplibre-gl": "5.24.1",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@types/node": "22.13.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "playwright": "1.65.1",
    "sharp": "^0.35.5",
    "to-ico": "^1.1.5",
    "typescript": "6.0.3",
    "vite": "7.3.8",
    "vite-plugin-pwa": "2.0.0"
  }
}

# Solo configuración pública. Nunca introducir claves secretas de Clerk, MongoDB o del proveedor GPS.
VITE_CLERK_PUBLISHABLE_KEY=
# Solo para un dominio satélite configurado en la misma instancia Clerk. URLs HTTPS del sitio primario.
VITE_CLERK_SATELLITE_DOMAIN=
VITE_CLERK_SIGN_IN_URL=
VITE_CLERK_SIGN_UP_URL=
# Vercel: dejar vacío u omitir. Android: origen HTTPS absoluto obligatorio para consumir API real.
VITE_API_ORIGIN=
# Proxy de desarrollo/preview. Vacío usa http://127.0.0.1:3000, sin iniciar otro backend.
VITE_DEV_API_ORIGIN=
# URL HTTPS de estilo MapLibre de proveedor autorizado (la clave del estilo es pública/restringida).
# Vacío: OpenFreeMap Liberty, con atribución; no requiere clave para desarrollo/demostración.
VITE_MAP_STYLE_URL=
# Herramientas opt-in solo en npm run dev/dev:https. Producción/PWA/APK siempre ocultan demo.
VITE_ENABLE_DEV_TOOLS=false
